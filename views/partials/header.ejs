<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Onyx AI</title>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <!-- Swiper (for carousels/slides) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

  <!-- Main Styles -->
  <link rel="stylesheet" href="/css/index.css" />


</head>
<body>
  <header class="header">
    <div class="header-left">
  <button id="menuBtn" class="menu-btn"><i class="fa-solid fa-bars"></i></button>
  <a href="/" class="logo">Onyx AI</a>
</div>

 <div class="search-container">
    <form action="/ai/ask" method="POST" class="search-bar">
    <input type="text" name="q" placeholder="Ask me anything..." />
    <button id="searchToggle" class="search-toggle" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
  
    </form>
</div>

  <div class="header-actions">
    <button id="darkBtn" class="dark-btn"><i class="fa-solid fa-moon"></i></button>
    <div class="profile">
      <i class="fa-solid fa-user-circle"></i>
      <img src="/images/abbie.jpg" alt="Abbie">
      <span><%=typeof user !=='undefined' && user ? user.name:"Guest"%></span>
    </div>
  </div>
</header>

  